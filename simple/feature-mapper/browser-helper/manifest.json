{
  "manifest_version": 3,
  "name": "Feature Mapper KR 브라우저 연결",
  "version": "0.5.0",
  "description": "화면·요청 매핑과 명시적으로 시작한 Scope 내 SPA 메뉴 탐색을 로컬 Workbench에 연결합니다.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "webRequest",
    "declarativeNetRequest",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Feature Mapper 연결"
  }
}
